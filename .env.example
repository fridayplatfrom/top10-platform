# ==============================================================================
# TOP 10 PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env and configure for your production domain & payment gateways
# ==============================================================================

# Server Network Configuration
PORT=3456
NODE_ENV=production
BASE_URL=https://top10.example.com

# Database Connection (MongoDB)
# Local container: mongodb://mongo:27017/top10
# MongoDB Atlas Cloud: mongodb+srv://<user>:<password>@cluster.mongodb.net/top10?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/top10
MONGODB_DB_NAME=top10

# PayPal Business API Credentials (Live Revenue & Sponsorship Retainers)
# Get credentials at: https://developer.paypal.com/dashboard/applications/live
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Security & Admin Access
ADMIN_SECRET_KEY=top10_super_secret_production_key_change_me
ADMIN_NOTIFICATION_EMAIL=admin@top10.example.com

# Analytics & SEO Verification
GOOGLE_SITE_VERIFICATION=google_site_verification_token
BING_SITE_VERIFICATION=bing_site_verification_token
