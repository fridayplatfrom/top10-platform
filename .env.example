# Inject these variables through the host. Node does not read this file directly.
PORT=3456
NODE_ENV=production
BASE_URL=https://top10.example.com

# MariaDB is required in production. Development can use an ignored runtime JSON file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# DB_PATH=/path/to/local/runtime.json

# Configure a unique editor secret and an optional separate publishing secret.
ADMIN_EMAIL=admin@top10.io
ADMIN_PASSWORD=
EDITORIAL_PUBLISH_KEY=

GOOGLE_SITE_VERIFICATION=google_site_verification_token
BING_SITE_VERIFICATION=bing_site_verification_token
