# ==============================================================================
# TOP 10 PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env and configure for your production domain & payment gateways
# ==============================================================================

# Server Network Configuration
PORT=3456
NODE_ENV=production
BASE_URL=https://top10.example.com

# Runtime reads local JSON; optional MariaDB asynchronously mirrors full snapshots.
# Set DB_PATH to persistent writable storage outside an ephemeral deployment checkout.
# DB_PATH=/var/lib/top10/db.json
# MariaDB is optional. Missing credentials or failed startup falls back to JSON.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# MongoDB variables are not supported. The Node process does not auto-load .env;
# inject these values through your host/process manager (Compose reads .env).

# PayPal Business API Credentials (Live Revenue & Sponsorship Retainers)
# Get credentials at: https://developer.paypal.com/dashboard/applications/live
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Security & Admin Access
# Set a strong unique password before first initialization. This does NOT rotate
# an existing stored admin password. Never deploy with the source-code fallback.
ADMIN_PASSWORD=
# Optional headless publishing key; leave unset unless needed.
PUBLISH_API_KEY=
ADMIN_NOTIFICATION_EMAIL=admin@top10.example.com

# Analytics & SEO Verification
GOOGLE_SITE_VERIFICATION=google_site_verification_token
BING_SITE_VERIFICATION=bing_site_verification_token
